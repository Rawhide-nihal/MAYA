{
  "manifest_version": 3,
  "name": "MAYA Browser Bridge",
  "version": "0.1.0",
  "description": "Local authenticated browser bridge for MAYA communication actions.",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://mail.google.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["common.js", "gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["common.js", "whatsapp.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["common.js", "telegram.js"],
      "run_at": "document_idle"
    }
  ]
}
